# ── IndexPilot environment ────────────────────────────────────────────────
# All optional. Without them the app runs fully local (embedded SQLite) so
# you can try every feature in demo mode. Add credentials to go live.

# Public base URL of this deployment (used for the Gmail OAuth redirect).
# In a sandbox preview this is your https://{port}-{sandbox}.e2b.app host.
NEXT_PUBLIC_APP_URL=

# Secret used to sign session cookies. Any long random string works.
SESSION_SECRET=

# ── Turso (libSQL) ────────────────────────────────────────────────────────
# When both are set, user data (profiles, accounts, keys, mail cache, chat)
# is stored on your Turso database instead of the embedded local SQLite file.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=
